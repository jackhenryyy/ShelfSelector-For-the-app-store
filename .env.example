# ===========================================
# The Shelf - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# -------------------------------------------
# App Configuration
# -------------------------------------------
PORT=5000
APP_BASE_URL=http://localhost:5000
NODE_ENV=development

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/theshelf

# -------------------------------------------
# Session
# -------------------------------------------
SESSION_SECRET=your-super-secret-session-key-change-this

# -------------------------------------------
# Spotify API (Optional - for Spotify users)
# -------------------------------------------
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# -------------------------------------------
# Apple Music API (Optional - for Apple Music users)
# -------------------------------------------
# Get these from https://developer.apple.com/account/resources/authkeys/list
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
# The private key content from your .p8 file
# Replace newlines with \n or paste the full key
APPLE_MUSIC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYourKeyContentHere\n-----END PRIVATE KEY-----
