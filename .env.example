# ===========================================
# The Shelf - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# -------------------------------------------
# App Configuration
# -------------------------------------------
PORT=5000
APP_BASE_URL=http://localhost:5000
NODE_ENV=development

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/theshelf

# -------------------------------------------
# Session
# -------------------------------------------
SESSION_SECRET=your-super-secret-session-key-change-this

# -------------------------------------------
# Spotify API (Optional - for Spotify users)
# -------------------------------------------
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# -------------------------------------------
# Apple Music API (Optional - for Apple Music users)
# -------------------------------------------
# Get these from https://developer.apple.com/account/resources/authkeys/list
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_MUSICKIT_KEY_ID=XXXXXXXXXX
# Base64-encoded contents of your .p8 private key file
# Generate with: base64 -i AuthKey_XXXXXXXX.p8 | tr -d '\n'
APPLE_MUSICKIT_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCllvdXJLZXlDb250ZW50SGVyZQotLS0tLUVORCBQUklWQVRFIEtFWS0tLS0t
# Optional: Apple Music storefront/region (default: us)
APPLE_STOREFRONT=us
